# 二选一：deepseek（云端） / ollama（本地）
SA_PROVIDER=deepseek

# --- DeepSeek ---
DEEPSEEK_API_KEY=
SA_DEEPSEEK_BASE=https://api.deepseek.com
SA_DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp

# --- Ollama ---
OLLAMA_URL=http://127.0.0.1:11434
SA_OLLAMA_MODEL=qwen2.5vl:7b

# --- 热键 ---
# Windows 支持 ctrl / alt / shift / win + 单字母或 F1–F12
# macOS / Linux 走 keyboard 库，写法相同（win 会映射成 cmd）
SA_HOTKEY=ctrl+alt+q
