# provider: deepseek | openai | anthropic | openrouter | ollama | custom
# custom = 任何 OpenAI 兼容端点（中转站 / one-api / vLLM / LM Studio / vLLM）
SA_PROVIDER=deepseek

# --- 当前生效的接口（在界面顶栏 API 里改，会自动写回这三行）---
SA_MODEL=
SA_BASE=
SA_KEY=

# --- 旧键仍然认，老配置不用改 ---
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SA_DEEPSEEK_BASE=https://api.deepseek.com
SA_DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
OLLAMA_URL=http://127.0.0.1:11434
SA_OLLAMA_MODEL=qwen2.5vl:7b

# --- 可选：覆盖单价（USD / 1M tokens）。留空则用内置价目表 ---
# SA_PRICE_IN=
# SA_PRICE_OUT=
# SA_PRICE_CACHED=

# --- 热键 ---
# Windows 支持 ctrl / alt / shift / win + 单字母或 F1–F12
# macOS / Linux 走 keyboard 库，写法相同（win 会映射成 cmd）
SA_HOTKEY=ctrl+alt+q
